# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=*

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_db?schema=public"

# JWT - Employee/Admin
JWT_ACCESS_SECRET=change_this_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# JWT - Guest
GUEST_JWT_SECRET=change_this_guest_secret
GUEST_TOKEN_EXPIRES_IN=30m

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Domain used to build table QR URLs
APP_DOMAIN=http://localhost:3001

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Redis (optional - only if enabled)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
