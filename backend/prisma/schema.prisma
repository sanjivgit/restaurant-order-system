// Restaurant Management System - Database Schema
// Designed to support multiple restaurants in the future without major changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EmployeeRole {
  ADMIN
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Restaurant {
  id        String    @id @default(uuid())
  name      String
  logo      String?
  phone     String?
  email     String?
  gstNumber String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches Branch[]

  @@map("restaurants")
}

model Branch {
  id           String       @id @default(uuid())
  restaurantId String
  name         String
  address      String?
  phone        String?
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id])
  employees  Employee[]
  tables     Table[]
  categories MenuCategory[]
  menuItems  MenuItem[]
  orders     Order[]

  @@index([restaurantId])
  @@map("branches")
}

model Employee {
  id           String         @id @default(uuid())
  employeeCode String         @unique
  name         String
  email        String         @unique
  phone        String?
  password     String
  role         EmployeeRole   @default(EMPLOYEE)
  // Admins may be null here (restaurant-wide access); branch employees must have a branch.
  branchId     String?
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("employees")
}

model MenuCategory {
  id        String    @id @default(uuid())
  branchId  String
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch Branch     @relation(fields: [branchId], references: [id])
  items  MenuItem[]

  @@index([branchId])
  @@map("menu_categories")
}

model MenuItem {
  id          String    @id @default(uuid())
  branchId    String
  categoryId  String
  name        String
  description String?
  image       String?
  price       Decimal   @db.Decimal(10, 2)
  isVeg       Boolean   @default(true)
  isAvailable Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch     Branch       @relation(fields: [branchId], references: [id])
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([branchId])
  @@index([categoryId])
  @@map("menu_items")
}

model Table {
  id          String    @id @default(uuid())
  branchId    String
  tableNumber String
  qrCodeUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch Branch  @relation(fields: [branchId], references: [id])
  orders Order[]

  @@unique([branchId, tableNumber])
  @@map("tables")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  // Guest token snapshot kept for traceability (guest tokens are short-lived JWTs, not DB rows).
  guestToken   String?
  restaurantId String
  branchId     String
  tableId      String
  status       OrderStatus @default(PENDING)
  subtotal     Decimal     @db.Decimal(10, 2)
  tax          Decimal     @db.Decimal(10, 2) @default(0)
  grandTotal   Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  branch Branch      @relation(fields: [branchId], references: [id])
  table  Table       @relation(fields: [tableId], references: [id])
  items  OrderItem[]
  bill   Bill?

  @@index([branchId])
  @@index([tableId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Bill {
  id         String   @id @default(uuid())
  orderId    String   @unique
  subtotal   Decimal  @db.Decimal(10, 2)
  tax        Decimal  @db.Decimal(10, 2) @default(0)
  discount   Decimal  @db.Decimal(10, 2) @default(0)
  grandTotal Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("bills")
}
